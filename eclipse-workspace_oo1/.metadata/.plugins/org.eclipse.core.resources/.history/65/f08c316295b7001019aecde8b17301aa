package ar.edu.unlp.info.oo1.ejercicio21_servicioDePaquetes;

import java.time.LocalDate;
import java.util.Date;

public class Envio_Interurbano extends Envio{
	private double distanciaKM;
	
	public Envio_Interurbano(String o, String d, LocalDate f, int p, double dist) {
		super(o, d, f, p);
		this.setDistanciaKM(dist);
		// TODO Auto-generated constructor stub
	}

	@Override
	public double calcularCosto() {
		double peso = this.getPeso();
		if(this.distanciaKM <= 100)
			return 20 * peso;
		else if(this.distanciaKM <= 500)
			return 25 * peso;
		return 30 * peso;
	}

	public double getDistanciaKM() {
		return distanciaKM;
	}

	public void setDistanciaKM(double distanciaKM) {
		this.distanciaKM = distanciaKM;
	}

	

}
